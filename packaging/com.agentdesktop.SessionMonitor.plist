<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentdesktop.SessionMonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/SessionMonitor.app/Contents/MacOS/SessionMonitor</string>
    </array>
    <!-- Start the island at login. No KeepAlive: quitting from its menu keeps it quit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
